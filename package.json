{
  "name": "@dwahdany/open-claude",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Run the opencode TUI on a Claude Code backend — an opencode v1.17.19 API server over the Claude Agent SDK",
  "type": "module",
  "license": "MIT",
  "bin": {
    "open-claude": "bin/open-claude.mjs"
  },
  "files": [
    "bin",
    "src",
    "index.ts",
    "README.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "opencode",
    "tui",
    "agent",
    "anthropic"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwahdany/open-claude.git"
  },
  "homepage": "https://github.com/dwahdany/open-claude#readme",
  "bugs": {
    "url": "https://github.com/dwahdany/open-claude/issues"
  },
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run typecheck"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.17.19",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "hono": "^4.12.30"
  }
}
